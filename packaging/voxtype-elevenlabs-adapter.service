[Unit]
Description=Voxtype to ElevenLabs transcription adapter
Documentation=https://github.com/ivokosir/voxtype-elevenlabs-adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/voxtype-elevenlabs-adapter serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=default.target
